# ACU Agent Configuration
# Copy this file to .env and fill in your actual values

# Ollama Configuration
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=60

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Host port used by Docker Compose when publishing MySQL locally.
MYSQL_HOST_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=acu_db
MYSQL_READ_ONLY_USER=acu_reader
MYSQL_READ_ONLY_PASSWORD=

# Vector Database Configuration
VECTOR_SEARCH_ENABLED=False
# Supported BrainCore engines: chromadb, faiss
VECTOR_DB_ENGINE=chromadb
VECTOR_DB_PATH=./data/vectors
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.3
AGENT_TOP_P=0.9
AGENT_CONTEXT_WINDOW=4096

# System Configuration
ACU_ENV=development
DEBUG=False
LOG_LEVEL=INFO
# API auth is forced on for ACU_ENV=staging/production.
# Local open mode must be an explicit local-only decision.
ACU_API_AUTH_REQUIRED=True
ACU_REQUIRE_API_KEY=True
ACU_ALLOW_INSECURE_LOCAL=False
ACU_ALLOW_OPERATIONAL_PUBLIC_ROUTES=False
ACU_SAFE_MODE=True
ACU_TOOLS_ENABLED=True
ACU_READ_ONLY_TOOLS_ENABLED=True
ACU_WRITE_TOOLS_ENABLED=False
ACU_EXTERNAL_TOOLS_ENABLED=False
ACU_PYTHON_SANDBOX_ENABLED=False
ACU_FILESYSTEM_WRITE_ENABLED=False
ACU_API_REST_ENABLED=False
ACU_WEB_TOOLS_ENABLED=False
ACU_AUDIT_FULL_PAYLOADS=False
ACU_AUDIT_REDACT_SECRETS=True
# Empty allowlist means all non-blocked tools can be used.
# For Galpon integration, keep write/external/critical tools blocked.
ACU_ALLOWED_TOOLS=
ACU_BLOCKED_TOOLS=peticion_api_rest,gestionar_archivos,ejecutar_python,registrar_leccion,consultar_lecciones_aprendidas,leer_pagina_web,busqueda_web,delegar_tarea,escribir_memoria_compartida
ACU_API_KEY=
# Optional multi-key role map: key=role1,role2;other=admin
# Roles: admin, chat, braincore_read, braincore_write, monitoring
ACU_API_KEYS=
# Optional CORS allowlist. Empty disables CORS middleware.
ACU_API_CORS_ORIGINS=
ACU_API_CORS_METHODS=GET,POST,DELETE,OPTIONS
ACU_API_CORS_HEADERS=Authorization,Content-Type,X-ACU-API-Key
ACU_API_CORS_ALLOW_CREDENTIALS=False
# 0 disables request body size enforcement. Example: 1048576 for 1 MiB.
ACU_API_MAX_REQUEST_BODY_BYTES=0
# 0 disables in-memory rate limiting. Example: 120 requests per 60 seconds.
ACU_API_RATE_LIMIT_REQUESTS=0
ACU_API_RATE_LIMIT_WINDOW_SECONDS=60
# Production baseline:
# ACU_ENV=production
# ACU_API_AUTH_REQUIRED=True
# ACU_REQUIRE_API_KEY=True
# ACU_ALLOW_INSECURE_LOCAL=False
# ACU_SAFE_MODE=True
# ACU_WRITE_TOOLS_ENABLED=False
# ACU_EXTERNAL_TOOLS_ENABLED=False
# ACU_PYTHON_SANDBOX_ENABLED=False
# ACU_FILESYSTEM_WRITE_ENABLED=False
# ACU_API_REST_ENABLED=False
# ACU_WEB_TOOLS_ENABLED=False
# ACU_AUDIT_FULL_PAYLOADS=False
# ACU_AUDIT_REDACT_SECRETS=True
# ACU_API_KEYS=chat-client=chat;ops-monitor=monitoring;brain-reader=braincore_read;brain-writer=braincore_write
# ACU_API_MAX_REQUEST_BODY_BYTES=1048576
# ACU_API_RATE_LIMIT_REQUESTS=120
# Pin production deploys to an immutable release tag when possible.
# ACU_IMAGE=ghcr.io/revoxetech/acu-core:1.5.0

# Scheduler mode: disabled, api, worker, all.
# Use worker in production and run: python -m src.api.scheduler
ACU_SCHEDULER_MODE=disabled
# Legacy default used when the specific retention variables are not set.
ACU_LOG_RETENTION_DAYS=30
# Audit retention applies to tool_execution_log and api_access_log.
ACU_AUDIT_RETENTION_DAYS=30
# Conversation retention applies to conversation_context and completed agent_sessions.
ACU_CONVERSATION_RETENTION_DAYS=30
ACU_BRAINCORE_SYNC_PATHS=

# Webhook Security
# Empty keeps local/mock webhook mode open. Set these in exposed environments.
ACU_TELEGRAM_WEBHOOK_SECRET=
ACU_SLACK_SIGNING_SECRET=
ACU_SLACK_MAX_SKEW_SECONDS=300
ACU_WEBHOOKS_ENABLED=False
ACU_WEBHOOK_SECRET_REQUIRED=True
# Optional comma-separated allowlists.
ACU_WEBHOOK_ALLOWED_TELEGRAM_CHATS=
ACU_WEBHOOK_ALLOWED_SLACK_USERS=
# In production, webhooks should always use provider secrets plus allowlists.
